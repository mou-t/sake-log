---
import Bottle from '../../components/Bottle.astro';
import Icon from '../../components/Icon.astro';
import TopBar from '../../components/TopBar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { heroImage, transitionName } from '../../lib/image';
import { getAllSake, MicrocmsConfigError } from '../../lib/microcms';
import { countryName, heroMark, placeName, presentLinks } from '../../lib/sake-view';
import type { SakeEntry } from '../../lib/types';

export async function getStaticPaths() {
	try {
		const entries = await getAllSake();
		return entries.map((entry) => ({
			params: { id: entry.id },
			props: { entry },
		}));
	} catch (error) {
		if (error instanceof MicrocmsConfigError) return [];
		throw error;
	}
}

interface Props {
	entry: SakeEntry;
}

const { entry } = Astro.props;
const mark = heroMark(entry.name);
const photo = entry.image?.url ? heroImage(entry.image.url) : null;
const place = placeName(entry);
const links = presentLinks(entry.link);
---

<BaseLayout title={entry.name} description={entry.name}>
	<TopBar backHref="/" title="投稿" />
	<div class="hero" transition:name={transitionName(entry.id)}>
		{
			photo ? (
				<img src={photo.src} srcset={photo.srcset} sizes={photo.sizes} alt="" />
			) : (
				<Bottle primary={mark.primary} secondary={mark.secondary} />
			)
		}
	</div>
	<div class="caption">
		<h1 class="sake-title">{entry.name}</h1>
		<div class="chips">
			<span class="chip">
				<Icon name="pin" size={12} weight={1.75} />
				{countryName(entry)}
			</span>
			{place && <span class="chip">{place}</span>}
		</div>
		<div class="hairline"></div>
		<section class="links" aria-labelledby="related-links">
			<h2 id="related-links" class="links-heading">関連リンク</h2>
			{
				links.length === 0 ? (
					<p class="empty">関連リンクはありません</p>
				) : (
					links.map((link) => (
						<a class="link-row" href={link.href} target="_blank" rel="noopener noreferrer">
							<span class="link-copy">
								<span class="link-title">{link.title}</span>
								<span class="link-sub">{link.subtitle}</span>
							</span>
							<Icon name="chevron-right" size={18} weight={1.75} />
						</a>
					))
				)
			}
		</section>
	</div>
</BaseLayout>
