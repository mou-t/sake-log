---
import BottomNav from '../components/BottomNav.astro';
import BrowseFilter from '../components/BrowseFilter.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import TopBar from '../components/TopBar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCatalog } from '../lib/microcms';

const catalog = await loadCatalog();
const entries = catalog.ok ? catalog.entries : [];
const emptyMessage = !catalog.ok
	? catalog.reason === 'config'
		? 'microCMS の環境変数を設定してください'
		: 'コンテンツを読み込めませんでした'
	: entries.length === 0
		? 'まだ投稿がありません'
		: null;
---

<BaseLayout title="探す">
	<TopBar title="探す" />
	<form class="search-form" action="/search" method="get" role="search">
		<label class="sr-only" for="q">酒名・国名</label>
		<input id="q" class="search-input" type="search" name="q" value="" placeholder="酒名・国名で探す" enterkeyhint="search" />
	</form>
	{
		emptyMessage ? (
			<p class="empty">{emptyMessage}</p>
		) : (
			<div data-browse="search">
				<PhotoGrid entries={entries} />
				<p class="empty" data-empty hidden>
					該当するお酒がありません
				</p>
			</div>
		)
	}
	<BottomNav />
	<BrowseFilter />
</BaseLayout>
