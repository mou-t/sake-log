---
import BottomNav from '../components/BottomNav.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import TopBar from '../components/TopBar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCatalog } from '../lib/microcms';
import { filterEntries } from '../lib/sake-view';

const q = Astro.url.searchParams.get('q') ?? '';
const catalog = await loadCatalog();
const entries = catalog.ok ? catalog.entries : [];
const filtered = catalog.ok ? filterEntries(entries, { q }) : [];
const emptyMessage = !catalog.ok
	? catalog.reason === 'config'
		? 'microCMS の環境変数を設定してください'
		: 'コンテンツを読み込めませんでした'
	: filtered.length === 0
		? q
			? '該当するお酒がありません'
			: 'まだ投稿がありません'
		: null;
---

<BaseLayout title="探す">
	<TopBar title="探す" />
	<form class="search-form" action="/search" method="get" role="search">
		<label class="sr-only" for="q">酒名・国名</label>
		<input id="q" class="search-input" type="search" name="q" value={q} placeholder="酒名・国名で探す" enterkeyhint="search" />
	</form>
	{emptyMessage ? <p class="empty">{emptyMessage}</p> : <PhotoGrid entries={filtered} />}
	<BottomNav />
</BaseLayout>
