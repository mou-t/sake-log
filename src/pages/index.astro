---
import BottomNav from '../components/BottomNav.astro';
import BrowseFilter from '../components/BrowseFilter.astro';
import Highlights from '../components/Highlights.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import SakeRows from '../components/SakeRows.astro';
import TopBar from '../components/TopBar.astro';
import ViewTabs from '../components/ViewTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCatalog } from '../lib/microcms';
import { profile } from '../lib/profile';
import { highlightStoryHref, homeQuery, profileStats, storyHighlights } from '../lib/sake-view';

const catalog = await loadCatalog();
const entries = catalog.ok ? catalog.entries : [];
const highlights = storyHighlights(entries).map((item) => ({
	name: item.name,
	initial: item.initial,
	href: highlightStoryHref(item.country),
}));
const emptyMessage = !catalog.ok
	? catalog.reason === 'config'
		? 'microCMS の環境変数を設定してください'
		: 'コンテンツを読み込めませんでした'
	: entries.length === 0
		? 'まだ投稿がありません'
		: null;
---

<BaseLayout title={profile.displayName}>
	<TopBar username={profile.username} />
	<ProfileHeader stats={profileStats(entries)} />
	{highlights.length > 0 && <Highlights items={highlights} />}
	<ViewTabs gridHref={homeQuery()} listHref={homeQuery('list')} view="grid" />
	{
		emptyMessage ? (
			<p class="empty">{emptyMessage}</p>
		) : (
			<div data-browse="home">
				<PhotoGrid entries={entries} />
				<SakeRows entries={entries} />
				<p class="empty" data-empty hidden>
					該当するお酒がありません
				</p>
			</div>
		)
	}
	<BottomNav />
	<BrowseFilter />
</BaseLayout>
