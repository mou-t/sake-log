---
interface Item {
	name: string;
	initial: string;
	href: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<nav class="highlights" aria-label="ハイライト">
	{
		items.map((item) => (
			<a class="hl" href={item.href} aria-label={`${item.name}のハイライト`}>
				<span class="ring" aria-hidden="true">
					<span class="bubble">{item.initial}</span>
				</span>
				<span class="hl-label">{item.name}</span>
			</a>
		))
	}
</nav>
