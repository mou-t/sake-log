---
import Icon from './Icon.astro';

interface Props {
	gridHref: string;
	listHref: string;
	view: 'grid' | 'list';
}

const { gridHref, listHref, view } = Astro.props;
---

<nav class="tabs" aria-label="表示">
	<a class:list={['tab', { active: view === 'grid' }]} href={gridHref} aria-label="グリッド" aria-current={view === 'grid' ? 'page' : undefined}>
		<Icon name="grid" size={20} weight={view === 'grid' ? 2 : 1.75} />
	</a>
	<a class:list={['tab', { active: view === 'list' }]} href={listHref} aria-label="リスト" aria-current={view === 'list' ? 'page' : undefined}>
		<Icon name="bookmark" size={20} weight={view === 'list' ? 2 : 1.75} />
	</a>
</nav>
