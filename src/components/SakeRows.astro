---
import Icon from './Icon.astro';
import { gridImage } from '../lib/image';
import { countryName } from '../lib/sake-view';
import type { SakeEntry } from '../lib/types';

interface Props {
	entries: SakeEntry[];
}

const { entries } = Astro.props;
---

<div class="rows">
	{
		entries.map((entry) => {
			const photo = entry.image?.url ? gridImage(entry.image.url) : null;
			return (
				<a class="row" href={`/sake/${entry.id}`}>
					<span class="thumb">
						{photo ? <img src={photo.src} alt="" /> : <span class="silhouette" />}
					</span>
					<span class="row-copy">
						<span class="row-name">{entry.name}</span>
						<span class="row-country">{countryName(entry)}</span>
					</span>
					<span class="row-chevron">
						<Icon name="chevron-right" size={18} weight={1.75} />
					</span>
				</a>
			);
		})
	}
</div>
