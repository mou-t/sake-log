---
import Icon from './Icon.astro';

interface Props {
	username?: string;
	title?: string;
	backHref?: string;
}

const { username, title, backHref } = Astro.props;
---

{
	backHref ? (
		<header class="topbar center">
			<a class="icon-slot" href={backHref} aria-label="戻る">
				<Icon name="chevron-left" size={24} />
			</a>
			<p class="topbar-title">{title}</p>
			<span class="icon-slot" aria-hidden="true">
				<Icon name="ellipsis" size={22} />
			</span>
		</header>
	) : (
		<header class="topbar">
			{title ? <h1 class="username">{title}</h1> : <a class="username" href="/">{username}</a>}
			<span class="icon-slot" aria-hidden="true">
				<Icon name="menu" size={22} />
			</span>
		</header>
	)
}
