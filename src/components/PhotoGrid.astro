---
import { gridImage, transitionName } from '../lib/image';
import { countryHighlights, countryName, gridLabel, placeName } from '../lib/sake-view';
import type { SakeEntry } from '../lib/types';

interface Props {
	entries: SakeEntry[];
}

const { entries } = Astro.props;
const featured = new Set(
	countryHighlights(entries)
		.filter((item) => item.country !== 'other')
		.map((item) => item.country),
);
---

<div class="grid" data-view="grid">
	{
		entries.map((entry, index) => {
			const photo = entry.image?.url ? gridImage(entry.image.url) : null;
			const country = countryName(entry);
			return (
				<a
					class:list={['cell', `tone-${index % 3}`, { 'has-photo': Boolean(photo) }]}
					href={`/sake/${entry.id}`}
					aria-label={`${entry.name}、${country}`}
					data-sake
					data-name={entry.name}
					data-country={country}
					data-place={placeName(entry) ?? ''}
					data-featured={featured.has(country) ? 'true' : 'false'}
					transition:name={transitionName(entry.id)}
				>
					{photo ? (
						<img class="photo" src={photo.src} srcset={photo.srcset} sizes={photo.sizes} alt="" />
					) : (
						<span class="silhouette" />
					)}
					<span class="cell-label" aria-hidden="true">
						{gridLabel(entry.name)}
					</span>
				</a>
			);
		})
	}
</div>
